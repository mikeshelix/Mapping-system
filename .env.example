# Copy to .env for local development. These are development-only values.
DATABASE_URL=postgres://hazard:hazard_dev@localhost:5433/hazard
TEST_DATABASE_URL=postgres://hazard:hazard_dev@localhost:5433/hazard_test

# Public base URL of the web app, used for map links in notifications.
APP_BASE_URL=http://localhost:3000

# NWS requires a User-Agent that identifies the application.
# Adding a contact address is recommended by NWS: "HelixcoWeatherApp/1.0 (ops@example.com)".
NWS_USER_AGENT=HelixcoWeatherApp/1.0

# Email. Leave BREVO_API_KEY empty to log messages to the console instead of sending.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=alerts@example.com
EMAIL_FROM_NAME=Helixco Weather Alerts

# Feed health
NWS_POLL_SECONDS=60
NWS_STALE_AFTER_SECONDS=600

# Local seed account (development only; created by `pnpm db:seed`).
SEED_ORG_NAME=Demo Restoration Co
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=dev-only-change-me

# NASA FIRMS satellite fire detections. Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Leave empty to run without this feed.
FIRMS_MAP_KEY=

# Text messages through Twilio (paid, usage-based). Leave empty to keep SMS switched off.
# Use either a sending number or a Messaging Service.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Public URL Twilio posts inbound texts to; must match exactly what is configured in Twilio.
TWILIO_WEBHOOK_URL=http://localhost:3000/api/sms/inbound

# Assistant (Anthropic API: paid, billed per question by the amount of text). Leave the key empty to keep it switched off.
ANTHROPIC_API_KEY=
# Model and thinking effort (low, medium, high). A smaller model such as claude-sonnet-5-5 costs about half as much per question.
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=medium
# Hard ceiling on assistant spend across all organizations per calendar month, in US dollars. The assistant pauses when it is reached.
ASSISTANT_MONTHLY_BUDGET_USD=150

# Area search: businesses from OpenStreetMap through the Overpass API (free, no key).
# The public server asks for at most about 10,000 requests a day; point this at your own Overpass server if you outgrow it.
OVERPASS_URL=https://overpass-api.de/api/interpreter
