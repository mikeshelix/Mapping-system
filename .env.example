# Copy to .env for local development. These are development-only values.
DATABASE_URL=postgres://hazard:hazard_dev@localhost:5433/hazard
TEST_DATABASE_URL=postgres://hazard:hazard_dev@localhost:5433/hazard_test

# Public base URL of the web app, used for map links in notifications.
APP_BASE_URL=http://localhost:3000

# NWS requires a User-Agent that identifies the application.
# Adding a contact address is recommended by NWS: "HelixcoWeatherApp/1.0 (ops@example.com)".
NWS_USER_AGENT=HelixcoWeatherApp/1.0

# Email. Leave BREVO_API_KEY empty to log messages to the console instead of sending.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=alerts@example.com
EMAIL_FROM_NAME=Helixco Weather Alerts

# Feed health
NWS_POLL_SECONDS=60
NWS_STALE_AFTER_SECONDS=600

# Local seed account (development only; created by `pnpm db:seed`).
SEED_ORG_NAME=Demo Restoration Co
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=dev-only-change-me
